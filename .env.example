COMPOSE_PROJECT_NAME=kanshi-demo
CORE_VERSION=1.3.0
DASHBOARD_VERSION=1.3.0
AGENT_VERSION=1.3.0
DEMO_AGENT_ID=generate-agent-id
DB_PASSWORD=generate-db-password
KANSHI_API_KEY=generate-ingest-key
KANSHI_DASHBOARD_KEY=generate-dashboard-key
KANSHI_WEBHOOK_SECRET=generate-webhook-secret
KANSHI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KANSHI_TRACE_RETENTION=168h
KANSHI_LOG_RETENTION=72h
